# Include documentation and root files
include README.md
include LICENSE
include requirements.txt
include EnvrionmentalVariablesToFill.md
include MANIFEST.in
include setup.py

# Include everything in gsv_oie package directory EXCEPT pretrained_models
recursive-include gsv_oie *
recursive-include extern/onnxruntime/dist *
recursive-include extern/MNN/dist *
recursive-exclude gsv_oie/pretrained_models *
global-exclude gsv_oie/pretrained_models/*
prune gsv_oie/pretrained_models

# Additional explicit exclusions for pretrained_models files
global-exclude gsv_oie/pretrained_models/**/*
global-exclude gsv_oie/pretrained_models/G2PWModel/*
global-exclude gsv_oie/pretrained_models/chinese-roberta-wwm-ext-large/*

# Exclude large model files that should be downloaded separately (but allow onnxruntime libs)
global-exclude *.mnn
global-exclude *.onnx
global-exclude *.safetensors
global-exclude *.pt
global-exclude *.pth
global-exclude *.ckpt

# Exclude compiled and cache files (but allow onnxruntime libs)
global-exclude *.pyc
global-exclude *.pyo
global-exclude *.pyd
global-exclude __pycache__
global-exclude .git*
global-exclude .DS_Store
global-exclude *.so
global-exclude *.dll
global-exclude *.dylib
global-exclude .pytest_cache
global-exclude .mypy_cache
global-exclude .coverage
global-exclude *.egg-info

# But explicitly allow onnxruntime libraries (this overrides the above exclusions)
recursive-include extern/onnxruntime/dist *.so
recursive-include extern/onnxruntime/dist *.a
recursive-include extern/onnxruntime/dist *.dll
recursive-include extern/onnxruntime/dist *.dylib

recursive-include extern/MNN/dist *.so
recursive-include extern/MNN/dist *.a
recursive-include extern/MNN/dist *.dll
recursive-include extern/MNN/dist *.dylib